# Copy to .env and fill in credentials.
# Values can be sourced from:
#   - hermes/switch-model.sh (local + gonka defaults)
#   - ~/.cline/data/secrets.json (GONKA_API_KEY / openAiApiKey)
#   - projects/repo/apps/words/.env (GOOGLE_API_KEY)

PORT=5001
HOST=0.0.0.0
DEFAULT_PROVIDER=local

LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_API_KEY=lm-studio
LOCAL_DEFAULT_MODEL=google/gemma-4-12b-qat
LOCAL_INPUT_PRICE_PER_M=0
LOCAL_OUTPUT_PRICE_PER_M=0
# Native LM Studio API (load/unload) — strip /v1 from LOCAL_BASE_URL if unset
# LOCAL_NATIVE_URL=http://localhost:1234
# LM_STUDIO_CLI=~/.lmstudio/bin/lms
# Optional: force context_length on /api/v1/models/load only (omit to use Studio UI setting)
# LOCAL_DEFAULT_CONTEXT_LENGTH=64000

# ComfyUI GPU lifecycle (used by /v1/gpu/*)
# COMFY_API_URL=http://127.0.0.1:8188
# COMFY_RUN_SCRIPT=ComfyUI/run.sh
# COMFY_PID_FILE=ComfyUI/comfyui.pid

GONKA_BASE_URL=https://proxy.gonka.gg/v1
GONKA_API_KEY=
GONKA_DEFAULT_MODEL=MiniMaxAI/MiniMax-M2.7
GONKA_INPUT_PRICE_PER_M=0
GONKA_OUTPUT_PRICE_PER_M=0

GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_API_KEY=
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash
GOOGLE_INPUT_PRICE_PER_M=0.30
GOOGLE_OUTPUT_PRICE_PER_M=2.50

# --- Cursor SDK (models via @cursor/sdk; chat via local Agent API) ---
# API key: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_DEFAULT_MODEL=composer-2.5@fast=false
CURSOR_CWD=..
CURSOR_DEFAULT_CONTEXT=200000
CURSOR_INPUT_PRICE_PER_M=0.50
CURSOR_OUTPUT_PRICE_PER_M=2.50
CURSOR_CACHE_READ_PRICE_PER_M=0.20
# CURSOR_MODEL_ALLOW=^composer-2\.5@fast=false$   # default when unset

# --- DeepSeek (OpenAI-compatible; models live from GET /models) ---
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_INPUT_PRICE_PER_M=0.14
DEEPSEEK_OUTPUT_PRICE_PER_M=0.28
DEEPSEEK_CACHE_READ_PRICE_PER_M=0.0028

# Optional catalog filters: regex on upstream model id (comma-separated).
# MODEL_ALLOW=^gemini-.*$          # all providers
# GOOGLE_MODEL_ALLOW=^gemini-2\.5-flash$
# CURSOR_MODEL_ALLOW=^composer-2\.5@fast=false$   # built-in default for cursor

FALLBACK_CHARS_PER_TOKEN=4
FALLBACK_INPUT_PRICE_PER_M=0.30
FALLBACK_OUTPUT_PRICE_PER_M=2.50

# Logs live in repo-root logs/ (../logs from proxy/)
# LOGS_DIR=logs
# COST_LOG_PATH=logs/costs.log
