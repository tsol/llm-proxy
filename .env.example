# Copy to .env and fill in credentials.
# Values can be sourced from:
#   - hermes/switch-model.sh (local + gonka defaults)
#   - ~/.cline/data/secrets.json (GONKA_API_KEY / openAiApiKey)
#   - projects/repo/apps/words/.env (GOOGLE_API_KEY)

PORT=5001
HOST=0.0.0.0
DEFAULT_PROVIDER=local

# --- Local LM Studio ---
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_API_KEY=lm-studio
LOCAL_DEFAULT_MODEL=google/gemma-4-12b-qat
LOCAL_INPUT_PRICE_PER_M=0
LOCAL_OUTPUT_PRICE_PER_M=0
# Native LM Studio API (load/unload) — strip /v1 from LOCAL_BASE_URL if unset
# LOCAL_NATIVE_URL=http://localhost:1234
# LM_STUDIO_CLI=~/.lmstudio/bin/lms
# Optional: force context_length on /api/v1/models/load only (omit to use Studio UI setting)
# LOCAL_DEFAULT_CONTEXT_LENGTH=64000

# ComfyUI GPU lifecycle (used by /v1/gpu/*)
# COMFY_API_URL=http://127.0.0.1:8188
# COMFY_RUN_SCRIPT=ComfyUI/run.sh
# COMFY_PID_FILE=ComfyUI/comfyui.pid

# --- Gonka proxy ---
GONKA_BASE_URL=https://proxy.gonka.gg/v1
GONKA_API_KEY=
GONKA_DEFAULT_MODEL=MiniMaxAI/MiniMax-M2.7
GONKA_INPUT_PRICE_PER_M=0
GONKA_OUTPUT_PRICE_PER_M=0
# GONKA_TPM=0       # tokens per minute (0 = unlimited)
# GONKA_RPM=0       # requests per minute
# GONKA_RPH=0       # requests per hour
# GONKA_RPD=0       # requests per day

# --- Google Gemini ---
# API key: https://aistudio.google.com/apikey
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_API_KEY=
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash
GOOGLE_INPUT_PRICE_PER_M=0.30
GOOGLE_OUTPUT_PRICE_PER_M=2.50
# GOOGLE_RPM=15     # default rate limit (override with env)

# --- Cursor SDK (models via @cursor/sdk; chat via local Agent API) ---
# API key: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_DEFAULT_MODEL=composer-2.5@fast=false
CURSOR_CWD=..
CURSOR_DEFAULT_CONTEXT=200000
CURSOR_INPUT_PRICE_PER_M=0.50
CURSOR_OUTPUT_PRICE_PER_M=2.50
CURSOR_CACHE_READ_PRICE_PER_M=0.20
# CURSOR_MODEL_ALLOW=^composer-2\.5@fast=false$   # default when unset
# CURSOR_RPM=30     # default rate limit

# --- DeepSeek ---
# API key: https://platform.deepseek.com/api_keys
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_INPUT_PRICE_PER_M=0.14
DEEPSEEK_OUTPUT_PRICE_PER_M=0.28
DEEPSEEK_CACHE_READ_PRICE_PER_M=0.0028
# DEEPSEEK_RPD=10000 # default daily request limit

# --- Cerebras ---
# API key: https://cloud.cerebras.ai
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_API_KEY=
CEREBRAS_DEFAULT_MODEL=gpt-oss-120b
CEREBRAS_INPUT_PRICE_PER_M=0.60
CEREBRAS_OUTPUT_PRICE_PER_M=0.90
# CEREBRAS_TPM=30000     # tokens per minute
# CEREBRAS_RPM=5         # requests per minute
# CEREBRAS_RPD=2400      # requests per day

# --- OpenRouter ---
# API key: https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o
OPENROUTER_INPUT_PRICE_PER_M=0
OPENROUTER_OUTPUT_PRICE_PER_M=0
# OpenRouter ranking/attribution headers
OPENROUTER_HTTP_REFERER=http://localhost:5001
OPENROUTER_X_TITLE=LLM Proxy
# OPENROUTER_RPM=200  # default rate limit

# --- Groq ---
# API key: https://console.groq.com/keys
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-4-maverick-17b-instruct
# Pricing is fetched per-model from the API; these are fallback defaults.
GROQ_INPUT_PRICE_PER_M=0
GROQ_OUTPUT_PRICE_PER_M=0
# GROQ_TPM=50000     # tokens per minute
# GROQ_RPM=30        # requests per minute

# --- Named model aliases (defines what /v1/models exposes) ---
# MODEL{n}_ALIAS = friendly name shown to the user
# MODEL{n}_TRY   = provider/model,provider/model,...  (first success wins, others are fallback)
#
# These env-defined aliases are LOCKED — they cannot be modified or deleted via the API.
# Additional aliases can be managed at runtime via /v1/aliases and persisted in store/aliases.json.
#
# MODEL1_ALIAS=gemma-4-12b
# MODEL1_TRY=local/google/gemma-4-12b-qat,gonka/Kimi-K2.6
# MODEL2_ALIAS=kimi-2.6
# MODEL2_TRY=gonka/Kimi-K2.6
# MODEL3_ALIAS=deepseek-v4-pro
# MODEL3_TRY=deepseek/deepseek-v4-pro

# --- Global fallback chain (used when model has no alias-specific TRY) ---
# Comma-separated "provider/model" entries. Tried in order on failure.
# MODEL_FALLBACK_CHAIN=gonka/Kimi-K2.6,deepseek/deepseek-v4-flash

# --- Model allowlist (optional regex filter for /v1/models) ---
# Leave empty to use MODEL{n}_ALIAS definitions above.
# MODEL_ALLOW=^gemini-.*$          # show only gemini models
# GOOGLE_MODEL_ALLOW=^gemini-2\.5-flash$
# CURSOR_MODEL_ALLOW=^composer-2\.5@fast=false$   # built-in default for cursor

# --- Rate limit overrides (env var > JSON metadata > hardcoded default) ---
# CEREBRAS_TPM=100000
# GROQ_RPM=60
# Any provider: PROVIDER_TPM, PROVIDER_RPM, PROVIDER_RPH, PROVIDER_RPD

# --- Rate limit fallback (legacy, kept for backward compat) ---
# RATE_LIMIT_FALLBACK_MODEL=gonka/Kimi-K2.6
# GENERAL_FALLBACK_MODEL=gonka/Kimi-K2.6

# --- System prompt injection (applied to every outgoing request) ---
# SYSTEM_PROMPT=
# SYSTEM_PROMPT_SUFFIX=

# Fallback token/cost estimation when upstream omits usage metadata
FALLBACK_CHARS_PER_TOKEN=4
FALLBACK_INPUT_PRICE_PER_M=0.30
FALLBACK_OUTPUT_PRICE_PER_M=2.50

# Logs live in repo-root logs/ (../logs from proxy/)
# LOGS_DIR=logs
# COST_LOG_PATH=logs/costs.log