{
  "name": "hermes-llm-proxy",
  "version": "1.1.0",
  "description": "OpenAI-compatible LLM router for Hermes (LM Studio, Gonka, Google Gemini, Cursor SDK)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/providers/model-metadata.json dist/providers/ && cp -r public dist/ && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "stats": "tsx scripts/stats.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.22",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ajv": "^8.20.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.21.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  }
}
